# =============================================================================
# dbt-ui Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ---- Keycloak OIDC (REQUIRED - app will not start without these) ----
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/<your-realm>
KEYCLOAK_JWKS_URI=https://keycloak.example.com/realms/<your-realm>/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=account

# ---- Git & Worktree Paths ----
GIT_REPOS_PATH=./git-repos
CATALOG_PATH=./catalog.json

# ---- Frontend (CORS) ----
DBT_UI__FRONTEND_URL=http://localhost

# ---- Optional: Feature Toggles & Limits ----
DBT_UI__METADV_ENABLED=true
DBT_UI__FRONTEND_LINEAGE_MAX_NODES=200
